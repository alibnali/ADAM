{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/alibnali/ADAM/schemas/RouterDecision.json",
  "title": "RouterDecision",
  "description": "Output of the ADAM IntentRouter.",
  "type": "object",
  "required": ["discipline", "element_type", "drawing_types", "engine_id", "confidence", "resolved_code"],
  "additionalProperties": false,
  "properties": {
    "discipline":       { "type": "string", "enum": ["structural","architectural","civil","mep","geotechnical"] },
    "element_type":     { "type": "string" },
    "drawing_types":    { "type": "array", "items": { "type": "string", "enum": ["plan","section","elevation","detail","schedule","3d_iso"] } },
    "engine_id":        { "type": "string" },
    "confidence":       { "type": "number", "minimum": 0.0, "maximum": 1.0 },
    "resolved_code":    { "type": "string" },
    "assumptions_made": { "type": "array", "items": { "type": "object" } }
  }
}
